<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- WidgetKit extensions are always sandboxed - this is enforced by
	     the OS, unlike the main Runner target which disables sandboxing
	     to run smartctl/system_profiler. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Signed with the PUA3NSL244 (Jithin Wails) team - see
	     ../NATIVE_WIDGETS.md. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>PUA3NSL244.driveguard.widget</string>
	</array>
</dict>
</plist>
