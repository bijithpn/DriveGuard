<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is disabled: DriveGuard invokes system_profiler/smartctl
	     via Process and reads /dev/disk* device nodes directly, neither of
	     which is possible for a sandboxed macOS app. See docs/permissions.md. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Shared with DriveGuardWidget so the widget extension can read the
	     latest drive snapshot even when the main app isn't running.
	     Signed with the PUA3NSL244 (Jithin Wails) team - see
	     ../NATIVE_WIDGETS.md. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>PUA3NSL244.driveguard.widget</string>
	</array>
</dict>
</plist>
